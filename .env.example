# URL of the solution under test
HARNESS_AGENT_URL=http://localhost:8000

# Optional: URL of an integration service for fetching CRs and test cases
HARNESS_INTEGRATION_URL=http://localhost:3001

# Optional: tenant/workspace ID required by the solution API
HARNESS_TENANT_ID=00000000-0000-0000-0000-000000000001

# Optional: override the number of runs per harness
HARNESS_ITERATIONS=5

# If your solution fetches CRs/tests from an external tool (e.g. ADO)
ADO_BASE_URL=
ADO_PROJECT_KEY=
ADO_TOKEN=
